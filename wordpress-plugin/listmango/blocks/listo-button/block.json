{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "listmango/button",
	"version": "1.0.0",
	"title": "Make it a List Button",
	"category": "embed",
	"description": "Add a \"Make it a List\" button so readers can turn your content into a checklist.",
	"keywords": [ "list", "checklist", "mango", "recipe", "grocery" ],
	"supports": {
		"html": false,
		"align": [ "left", "center", "right" ],
		"multiple": true
	},
	"attributes": {
		"color": {
			"type": "string",
			"default": ""
		},
		"radius": {
			"type": "number",
			"default": -1
		}
	},
	"textdomain": "listmango",
	"render": "file:./render.php"
}
